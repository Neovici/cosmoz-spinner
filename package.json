{
  "name": "@neovici/cosmoz-spinner",
  "version": "1.0.3",
  "description": "A spinner component for Pion.js",
  "keywords": [
    "lit-html",
    "web-components"
  ],
  "homepage": "https://github.com/Neovici/cosmoz-spinner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neovici/cosmoz-spinner.git"
  },
  "license": "Apache-2.0",
  "author": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "lint": "tsc && eslint --cache .",
    "check:duplicates": "check-duplicate-components",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run storybook:start",
    "dev": "npm run storybook:start",
    "test": "wtr --coverage",
    "test:watch": "wtr --watch",
    "storybook:start": "storybook dev -p 8000",
    "storybook:build": "storybook build",
    "storybook:deploy": "storybook-to-ghpages",
    "storybook:preview": "npm run storybook:build && http-server ./storybook-static/ --silent",
    "prepare": "husky",
    "changeset": "changeset"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        1,
        "always",
        100
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./lightbox": "./dist/lightbox.js"
  },
  "dependencies": {
    "@pionjs/pion": "^2.5.2",
    "lit-html": "^3.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.0",
    "@neovici/cfg": "^2.8.0",
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "1.62.1",
    "@storybook/web-components-vite": "^10.5.10",
    "@types/mocha": "^10.0.6",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.0",
    "http-server": "^14.1.1",
    "husky": "^9.0.11",
    "lint-staged": "^17.0.7",
    "storybook": "^9.1.5",
    "typescript": "^5.4.5"
  }
}
